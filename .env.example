# --- Docker / PostgreSQL ---
POSTGRES_USER=salon
POSTGRES_PASSWORD=promeni_me
POSTGRES_DB=salon
POSTGRES_PORT=5432

# --- Aplikacija ---
# Mora da odgovara vrednostima iznad (ako menjas lozinku ili port, promeni ih i ovde).
DATABASE_URL=postgres://salon:promeni_me@127.0.0.1:5432/salon

# Osnovni domen platforme BEZ porta. Saloni su na subdomenima: demo.localhost, ana.tvojsajt.rs
# Sam osnovni domen (http://localhost:3000) je domen platforme: tu je /admin.
BASE_DOMAIN=localhost

# Kljuc za potpisivanje sesija (najmanje 32 znaka). Generisi svoj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=promeni_me_na_nasumicnu_vrednost_od_32_znaka

# Slike galerije (lokalni disk). Na VPS-u montiraj volume ovde.
# STORAGE_DIR=data/media
