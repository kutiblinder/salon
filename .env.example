# --- Docker / PostgreSQL ---
POSTGRES_USER=salon
POSTGRES_PASSWORD=promeni_me
POSTGRES_DB=salon
POSTGRES_PORT=5432

# pgAdmin (lokalno): http://127.0.0.1:5050
# PGADMIN_EMAIL=admin@admin.rs
# PGADMIN_PASSWORD=admin
# PGADMIN_PORT=5050

# --- Aplikacija ---
# Mora da odgovara vrednostima iznad (ako menjas lozinku ili port, promeni ih i ovde).
DATABASE_URL=postgres://salon:promeni_me@127.0.0.1:5432/salon

# Osnovni domen platforme BEZ porta. http://localhost:3000 je admin.
# Saloni u razvoju: ateljekosic.rs, zenmasaza.rs, bellanails.rs (npm run hosts:dev).
BASE_DOMAIN=localhost

# Kljuc za potpisivanje sesija (najmanje 32 znaka). Generisi svoj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=promeni_me_na_nasumicnu_vrednost_od_32_znaka

# Slike galerije (lokalni disk). Na VPS-u montiraj volume ovde.
# STORAGE_DIR=data/media

# Email (Resend). Bez ključa u razvoju se poruka ispisuje u konzolu.
# RESEND_API_KEY=
# EMAIL_FROM=Demo Salon <obavestenja@tvojsajt.rs>

# Tajni ključ za POST /api/jobs/expire-pending (produkcijski cron kontejner).
# CRON_SECRET=

# Let's Encrypt nalog za Caddy (produkcija).
# CADDY_EMAIL=ti@primer.rs
